# Server Environment Variables
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/devtrack?retryWrites=true&w=majority
CLIENT_URL=http://localhost:8443

# Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# AI Coach Configuration (OpenAI, Groq, OpenRouter, DeepSeek, or Gemini OpenAI-compatible endpoint)
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
